{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "outDir": "./dist/schematics",
    "rootDir": "./schematics",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
